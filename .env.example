# Copy to .env.local. Values below are for the Supabase local stack (`supabase start`), which prints them.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only when running GoTrue by itself instead of the full local stack (docs/dev-setup.md):
# the app forwards /auth/v1/* to this address and NEXT_PUBLIC_SUPABASE_URL points at the app itself.
# SUPABASE_AUTH_INTERNAL_URL=http://127.0.0.1:9999

# The scheduled compliance job (POST /api/compliance/run) runs for every company when this header secret matches.
# Leave it unset locally and run `npm run compliance:run` instead, or press "Run the compliance job now" in the office.
# COMPLIANCE_RUN_SECRET=

# Hosted Supabase: DATABASE_URL is the project's connection string (pooler, transaction mode is fine),
# the URL and keys come from the project's API settings.
