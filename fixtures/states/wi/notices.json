{
  "description": "Notice timing cases. Rule values come from lib/compliance/rules/wi.ts.",
  "cases": [
    {
      "id": "post-app-due",
      "input": {
        "kind": "post_application",
        "visit_departed_at": "2027-05-03T15:40:00-05:00"
      },
      "expected": {
        "due_by_date": "2027-06-02"
      },
      "rule": "ATCP 29.22: within 30 days"
    },
    {
      "id": "post-app-electronic-no-consent",
      "input": {
        "kind": "post_application",
        "channel": "email",
        "e_notice_consent_at": null
      },
      "expected": {
        "allowed": false,
        "reason": "electronic delivery needs prior written consent"
      },
      "rule": "ATCP 29.22"
    },
    {
      "id": "post-app-electronic-consent-after",
      "input": {
        "kind": "post_application",
        "channel": "sms",
        "e_notice_consent_at": "2027-05-04T09:00:00-05:00",
        "visit_departed_at": "2027-05-03T15:40:00-05:00"
      },
      "expected": {
        "allowed": false,
        "reason": "consent must come before the application"
      },
      "rule": "ATCP 29.22"
    },
    {
      "id": "annual-offer",
      "input": {
        "kind": "pre_application_offer",
        "agreement_starts_on": "2027-01-01",
        "term_months": 24,
        "last_offer_sent_on": "2027-01-02"
      },
      "expected": {
        "next_offer_due_by": "2028-01-02"
      },
      "rule": "ATCP 29.55(2)(a): repeat at least annually on contracts over one year"
    },
    {
      "id": "landscape-registry-phone",
      "input": {
        "kind": "landscape_advance",
        "registry_match": true,
        "channel": "phone",
        "scheduled_start": "2027-05-12T08:00:00-05:00"
      },
      "expected": {
        "send_by": "2027-05-11T20:00:00-05:00"
      },
      "rule": "ATCP 29.56(8): at least 12 hours before"
    },
    {
      "id": "landscape-registry-mail-weekend",
      "input": {
        "kind": "landscape_advance",
        "registry_match": true,
        "channel": "mail",
        "scheduled_start": "2027-05-10T08:00:00-05:00"
      },
      "expected": {
        "postmark_by_date": "2027-05-06"
      },
      "rule": "ATCP 29.56(8): postmarked at least 2 business days before; 2027-05-10 is a Monday, so count back Friday and Thursday",
      "note": "Holiday handling is an open question; this case avoids holidays."
    },
    {
      "id": "landscape-no-match",
      "input": {
        "kind": "landscape_advance",
        "registry_match": false
      },
      "expected": {
        "required": false
      }
    },
    {
      "id": "rei-sign",
      "input": {
        "kind": "rei_sign",
        "application_type": "residential",
        "product_rei_hours": 4
      },
      "expected": {
        "required": true,
        "min_size_inches": [
          8.5,
          11
        ],
        "remove_after_hours": 4
      },
      "rule": "ATCP 29.55(4)"
    }
  ]
}
